venv/
__pycache__/
*.pyc
*.pyo

# MediaPipe model cache
mediapipe/

# Whisper model cache (downloaded per-machine, ~74 MB)
# Default location: ~/.cache/huggingface/hub/
# If ever stored locally:
faster_whisper_models/

# Piper TTS voice models (downloaded per-machine via setup_assistant.sh)
models/piper/

# Kokoro TTS voice model (downloaded per-machine, ~338 MB)
models/kokoro/

# Device-local calibration data (per-machine, never commit)
calibration/*.json

# udev setup output (per-machine)
permissions_setup.log

# Computa-mode device-local files
computa-mode/venv/
computa-mode/voice_profile.npy
computa-mode/cyberpunk_wallpaper.bmp

# Vosk model (downloaded per-machine)
computa-mode/models/

# Audio test recordings (generated by demo_mic.py)
*.wav

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
