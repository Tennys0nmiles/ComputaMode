[Desktop Entry]
Type=Application
Name=Computa Voice Listener
Comment=Push-to-talk voice-activated Claude Code launcher
Exec=__VENV_PYTHON__ __COMPUTA_DIR__/computa-listener.py
Icon=audio-input-microphone
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Application
X-GNOME-Autostart-Delay=5
StartupNotify=false
